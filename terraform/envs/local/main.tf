# =====================================================================
# 0단계: 연결 확인 (Smoke test)
# ---------------------------------------------------------------------
# 아직 리소스를 만들지 않습니다. data 소스는 "읽기 전용 조회"라서
# apply 해도 아무것도 생성되지 않습니다.
# Terraform → Floci 연결과 자격증명/리전 설정이 맞는지만 확인합니다.
# =====================================================================

# "지금 나는 누구로 인증되어 있는가?" (= aws sts get-caller-identity)
data "aws_caller_identity" "current" {}

# "지금 어느 리전에 붙어 있는가?"
data "aws_region" "current" {}

# 리전의 가용영역(AZ) 목록. 1단계에서 서브넷을 AZ별로 나눌 때 사용합니다.
data "aws_availability_zones" "available" {
  state = "available"
}
